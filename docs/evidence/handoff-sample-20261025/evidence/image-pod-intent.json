{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "eap-handoff-image-20261025-r1",
    "namespace": "eap"
  },
  "spec": {
    "nodeName": "ate-node2",
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 1200,
    "volumes": [
      {
        "name": "shared",
        "emptyDir": {}
      }
    ],
    "initContainers": [
      {
        "name": "stage",
        "image": "docker.m.daocloud.io/library/node@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402",
        "command": [
          "sh",
          "-c",
          "mkdir /shared/context && while [ ! -f /shared/start ]; do sleep 1; done"
        ],
        "volumeMounts": [
          {
            "name": "shared",
            "mountPath": "/shared"
          }
        ]
      }
    ],
    "containers": [
      {
        "name": "build",
        "image": "gcr.m.daocloud.io/kaniko-project/executor@sha256:9e69fd4330ec887829c780f5126dd80edc663df6def362cd22e79bcdf00ac53f",
        "args": [
          "--context=dir:///shared/context",
          "--dockerfile=Dockerfile",
          "--destination=10.186.133.66:5001/eap-handoff-sample:20261025-r1",
          "--build-arg=FRAMEWORK_BASE=10.186.133.66:5001/eap-framework-runner@sha256:155c6cf52557a95b8d3c2c5ffaead590cd9ae2c14e272c4fafc8903f8a0cf529",
          "--insecure",
          "--insecure-pull",
          "--single-snapshot",
          "--digest-file=/dev/termination-log"
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "2",
            "memory": "1536Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "shared",
            "mountPath": "/shared"
          }
        ]
      }
    ]
  }
}
