{
  "server_url": "https://eap.example.com",
  "allow_insecure_http": false,
  "state_dir": "/var/lib/eap-discovery-agent",
  "content_state_dir": "/var/lib/eap-content-proxy",
  "scan": {
    "processes": true,
    "docker": true,
    "ports": true,
    "files": true,
    "roots": ["/opt", "/srv", "/home"],
    "max_files": 3000,
    "max_depth": 6
  },
  "content_proxy": {
    "listen": "127.0.0.1:8686",
    "upstream_url": "https://api.openai.com",
    "provider": "openai-compatible",
    "usage_pool_key": "shared-openai-production",
    "instrumentation_token_file": "/var/lib/eap-content-proxy/instrumentation-token",
    "agent_id": 0,
    "max_capture_bytes": 4194304
  },
  "auto_attach": [],
  "host_observer": {
    "mode": "auto",
    "max_observations": 1000
  },
  "ebpf_observer": {
    "mode": "auto",
    "batch_interval_seconds": 30,
    "max_events": 1000
  }
}
