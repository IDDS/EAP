+type identityControl struct {
+	ateapipb.UnimplementedControlServer
+	mu                                  sync.Mutex
+	actor                               *ateapipb.Actor
+	template                            *ateapipb.ActorTemplate
+	creates, resumes, suspends, deletes int
+	lost                                bool
+	claims                              store.TaskActorIdentityStore
+}
+
+func (m *identityControl) CreateAtespace(context.Context, *ateapipb.CreateAtespaceRequest) (*ateapipb.Atespace, error) {
+	return &ateapipb.Atespace{}, nil
+}
+func (m *identityControl) GetActorTemplate(context.Context, *ateapipb.GetActorTemplateRequest) (*ateapipb.ActorTemplate, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.template == nil {
+		return nil, status.Error(codes.NotFound, "missing")
+	}
+	return proto.Clone(m.template).(*ateapipb.ActorTemplate), nil
+}
+func (m *identityControl) CreateActorTemplate(_ context.Context, q *ateapipb.CreateActorTemplateRequest) (*ateapipb.ActorTemplate, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.template = proto.Clone(q.ActorTemplate).(*ateapipb.ActorTemplate)
+	return proto.Clone(m.template).(*ateapipb.ActorTemplate), nil
+}
+func (m *identityControl) CreateActor(ctx context.Context, q *ateapipb.CreateActorRequest) (*ateapipb.Actor, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.creates++
+	id, err := m.claims.GetTaskActorIdentity(ctx, q.Actor.Metadata.Atespace, q.Actor.Metadata.Name)
+	if err != nil || id.UID != "" {
+		return nil, status.Error(codes.FailedPrecondition, "create intent not durable before native call")
+	}
+	m.actor = proto.Clone(q.Actor).(*ateapipb.Actor)
+	m.actor.Metadata.Uid = "56592f45-ed6b-4d34-8d20-909957c16946"
+	m.actor.Status = &ateapipb.ActorStatus{State: ateapipb.ActorState_ACTOR_STATE_SUSPENDED}
+	if m.lost {
+		return nil, status.Error(codes.DeadlineExceeded, "synthetic lost create receipt")
+	}
+	return proto.Clone(m.actor).(*ateapipb.Actor), nil
+}
+func (m *identityControl) GetActor(context.Context, *ateapipb.GetActorRequest) (*ateapipb.Actor, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.actor == nil {
+		return nil, status.Error(codes.NotFound, "missing")
+	}
+	return proto.Clone(m.actor).(*ateapipb.Actor), nil
+}
+func (m *identityControl) SuspendActor(context.Context, *ateapipb.SuspendActorRequest) (*ateapipb.SuspendActorResponse, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.suspends++
+	return &ateapipb.SuspendActorResponse{}, nil
+}
+func (m *identityControl) ResumeActor(context.Context, *ateapipb.ResumeActorRequest) (*ateapipb.ResumeActorResponse, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.resumes++
+	return &ateapipb.ResumeActorResponse{Actor: proto.Clone(m.actor).(*ateapipb.Actor)}, nil
+}
+func (m *identityControl) DeleteActor(context.Context, *ateapipb.DeleteActorRequest) (*ateapipb.Actor, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.deletes++
+	return proto.Clone(m.actor).(*ateapipb.Actor), nil
+}
