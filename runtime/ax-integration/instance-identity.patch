+)
+
+func (s *MemoryStore) GetTaskActorIdentity(ctx context.Context, space, name string) (*store.ActorIdentity, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	x, ok := s.actorIdentities[taskKey(space, name)]
+	if !ok {
+		return nil, store.ErrNotFound
+	}
+	return &x, nil
+}
+
+func (s *MemoryStore) ClaimTaskActorCreation(ctx context.Context, space, name, template string) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if template == "" {
+		return false, store.ErrActorIdentityConflict
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := taskKey(space, name)
+	if _, ok := s.tasks[key]; !ok {
+		return false, store.ErrNotFound
+	}
+	if s.tasks[key].GetStatus().GetPhase() == "Terminating" {
+		return false, store.ErrActorIdentityConflict
+	}
+	if _, ok := s.actorIdentities[key]; ok {
+		return false, nil
+	}
+	s.actorIdentities[key] = store.ActorIdentity{Template: template}
+	return true, nil
+}
+
+func (s *MemoryStore) RecordTaskActorIdentity(ctx context.Context, space, name string, value store.ActorIdentity) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if value.UID == "" || value.Template == "" {
+		return store.ErrActorIdentityConflict
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := taskKey(space, name)
+	previous, ok := s.actorIdentities[key]
+	if !ok || previous.Template != value.Template || previous.UID != "" && previous.UID != value.UID {
+		return store.ErrActorIdentityConflict
+	}
+	s.actorIdentities[key] = value
+	return nil
+}
