+func TestIdentityReconcileBindsOnlyNativeCreateReceipt(t *testing.T) {
+	r, s, m, task := fixture(t)
+	ctx := context.Background()
+	first, err := r.Reconcile(ctx, task)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.creates != 1 || m.suspends != 1 {
+		t.Fatal("native create/suspend contract failed")
+	}
+	id, _ := s.GetTaskActorIdentity(ctx, "eap-ax", "task")
+	if id.UID == "" || id.Template == "" {
+		t.Fatal("native UID was not persisted")
+	}
+	found := false
+	for _, c := range first.Status.Conditions {
+		if c.Type == ActorIdentityCondition {
+			var v store.ActorIdentity
+			if c.Status != "True" || json.Unmarshal([]byte(c.Message), &v) != nil || v != *id {
+				t.Fatal("wire identity does not match native receipt")
+			}
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("native identity not exposed through existing status protocol")
+	}
+	if path := os.Getenv("EAP_TEST_WIRE_PATH"); path != "" {
+		raw, err := proto.Marshal(first)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(path, raw, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = r.Reconcile(ctx, task); err != nil {
+		t.Fatal(err)
+	}
+	if m.creates != 1 {
+		t.Fatal("bound task recreated actor")
+	}
+	// The template and its embedded task YAML contain public metadata only.
+	for _, e := range m.template.Containers[0].Env {
+		if strings.Contains(e.Name, "TOKEN") || e.Name == "GEMINI_API_KEY" {
+			t.Fatal("shared credential in template")
+		}
+	}
+}
+func TestIdentityLostCreateReceiptCannotReplayAfterRestart(t *testing.T) {
+	r, s, m, task := fixture(t)
+	m.lost = true
+	ctx := context.Background()
+	if _, err := r.Reconcile(ctx, task); err == nil {
+		t.Fatal("lost create receipt accepted")
+	}
+	id, _ := s.GetTaskActorIdentity(ctx, "eap-ax", "task")
+	if id.UID != "" {
+		t.Fatal("name lookup adopted unknown native actor")
+	}
+	restarted := NewTaskReconciler(r.client, "default", "ax-system")
+	NewWorker(s, restarted, "test", "restart")
+	restarted.SecretResolver = r.SecretResolver
+	// Even if the original actor later disappears, its original intent cannot recreate it.
+	m.mu.Lock()
+	m.actor = nil
+	m.lost = false
+	m.mu.Unlock()
+	if _, err := restarted.Reconcile(ctx, task); err == nil {
+		t.Fatal("unknown create recovered by retry")
+	}
+	if m.creates != 1 || m.resumes != 0 || m.suspends != 0 {
+		t.Fatal("restart repeated create or touched unowned actor")
+	}
+}
+func TestIdentityReplacementUIDBlocksResumeAndDelete(t *testing.T) {
+	r, _, m, task := fixture(t)
+	ctx := context.Background()
+	if _, err := r.Reconcile(ctx, task); err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	m.actor.Metadata.Uid = "77c266aa-e65e-4c66-ac08-02fcf07499c2"
+	m.mu.Unlock()
+	task.Status.Phase = "Running"
+	if _, err := r.Reconcile(ctx, task); err == nil {
+		t.Fatal("replacement UID accepted")
+	}
+	if err := r.reconcileOwnedDelete(ctx, task); err == nil {
+		t.Fatal("foreign replacement deleted")
+	}
+	if m.creates != 1 || m.resumes != 0 || m.deletes != 0 || m.suspends != 1 {
+		t.Fatal("identity mismatch changed native actor")
+	}
+}
+func TestIdentityInvalidSecretConfigHasNoNativeSideEffects(t *testing.T) {
+	r, _, m, task := fixture(t)
