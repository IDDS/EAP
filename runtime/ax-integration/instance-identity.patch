+package controller
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/google/ax/internal/store"
+	"github.com/google/ax/internal/substrate"
+	"github.com/google/ax/pkg/apis/v1alpha1"
+)
+
+const ActorIdentityCondition = "EAPActorIdentity"
+
+func identityEnv(task *v1alpha1.Task) (map[string]string, error) {
+	env := map[string]string{}
+	for _, e := range task.GetSpec().GetEnv() {
+		if e.GetName() == "" {
+			continue
+		}
+		if _, exists := env[e.Name]; exists && e.Name == "EAP_IDENTITY_MODE" {
+			return nil, errors.New("duplicate task identity mode")
+		}
+		env[e.Name] = e.Value
+	}
+	if env["EAP_IDENTITY_MODE"] != "" {
+		seen := map[string]bool{}
+		for _, e := range task.GetSpec().GetEnv() {
+			if seen[e.Name] {
+				return nil, errors.New("duplicate instance identity configuration")
+			}
+			seen[e.Name] = true
+		}
+		if err := substrate.ValidateIdentityConfig(task.GetMetadata().GetName(), task.GetSpec().GetImage(), env); err != nil {
+			return nil, err
+		}
+		if len(task.GetSpec().GetCommand()) != 0 || task.GetSpec().GetDebug() || len(task.GetSpec().WorkspaceRefs()) != 0 {
+			return nil, errors.New("instance task uses the frozen EAP runner contract")
+		}
+	}
+	return env, nil
+}
+
+// Bind the receipt before any actor lifecycle command. A persistent claim with
+// no UID is intentionally terminal for creation: a restart cannot retry it.
+func (r *TaskReconciler) ensureOwnedActor(ctx context.Context, task *v1alpha1.Task, templateSpace, templateName string) (store.ActorIdentity, error) {
+	var empty store.ActorIdentity
+	if r.identityStore == nil {
+		return empty, errors.New("task identity store unavailable")
+	}
+	space, name := task.Metadata.Atespace, task.Metadata.Name
+	frozen := templateSpace + "/" + templateName
+	identity, err := r.identityStore.GetTaskActorIdentity(ctx, space, name)
+	if err != nil && !errors.Is(err, store.ErrNotFound) {
+		return empty, err
+	}
+	if errors.Is(err, store.ErrNotFound) {
+		claimed, e := r.identityStore.ClaimTaskActorCreation(ctx, space, name, frozen)
+		if e != nil {
+			return empty, e
+		}
+		if !claimed {
+			return empty, errors.New("another worker owns the durable actor create intent")
+		}
+		actor, e := r.client.CreateOwnedActor(ctx, space, name, templateSpace, templateName)
+		if e != nil {
+			return empty, e
+		}
+		value := store.ActorIdentity{Template: frozen, UID: actor.GetMetadata().GetUid()}
+		if e = r.identityStore.RecordTaskActorIdentity(ctx, space, name, value); e != nil {
+			return empty, e
+		}
+		identity = &value
+	}
+	if identity.Template != frozen || identity.UID == "" {
+		return empty, errors.New("native actor creation result unknown; replay and name adoption disabled")
+	}
+	if _, err = r.client.GetOwnedActor(ctx, space, name, templateSpace, templateName, identity.UID); err != nil {
+		return empty, err
+	}
+	if r.taskStore != nil {
+		latest, e := r.taskStore.GetTask(ctx, space, name)
+		if e != nil {
+			return empty, e
+		}
+		if latest.GetStatus().GetPhase() == v1alpha1.PhaseTerminating {
+			return empty, errors.New("task is terminating; actor lifecycle change blocked")
+		}
+	}
+	raw, _ := json.Marshal(identity)
+	r.setCondition(task, ActorIdentityCondition, "True", "CreateReceiptBound", string(raw), time.Now())
+	return *identity, nil
+}
+
+// Deletion also requires the original UID. Unknown ownership never authorizes
+// deleting an actor that happens to have the same task name.
+func (r *TaskReconciler) reconcileOwnedDelete(ctx context.Context, task *v1alpha1.Task) error {
+	if r.identityStore == nil {
+		return errors.New("task identity store unavailable")
+	}
+	identity, err := r.identityStore.GetTaskActorIdentity(ctx, task.Metadata.Atespace, task.Metadata.Name)
+	if err != nil || identity.UID == "" {
+		return errors.New("task actor ownership unconfirmed; deletion blocked")
+	}
+	parts := strings.Split(identity.Template, "/")
+	if len(parts) != 2 {
+		return errors.New("invalid frozen task template")
+	}
+	if _, err = r.client.GetOwnedActor(ctx, task.Metadata.Atespace, task.Metadata.Name, parts[0], parts[1], identity.UID); err != nil {
+		return fmt.Errorf("task actor identity changed; deletion blocked: %w", err)
+	}
+	if err = r.client.DeleteActor(ctx, task.Metadata.Atespace, task.Metadata.Name); err != nil {
+		return err
+	}
+	// A dedicated task template is removed by its exact frozen reference. Do not
+	// enumerate/delete other templates sharing a truncated task-name prefix.
+	return r.client.DeleteActorTemplate(ctx, parts[0], parts[1])
+}
