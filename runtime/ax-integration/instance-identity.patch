+package store
+
+import (
+	"context"
+	"errors"
+)
+
+// ActorIdentity is an irreversible create intent followed by a native CreateActor
+// receipt. It contains public metadata only; it is never a bearer credential.
+// The intent outlives task deletion and has no TTL, so a recycled task name cannot
+// recreate or silently adopt a different actor after an uncertain native call.
+type ActorIdentity struct {
+	Template string `json:"actorTemplate"`
+	UID      string `json:"actorUid"`
+}
+
+var ErrActorIdentityConflict = errors.New("task actor identity conflict")
+
+// TaskActorIdentityStore is separate from the legacy task status update API.
+// Claim returns true for exactly one caller. Recording requires the same frozen
+// template and may only bind the UID once. Ordinary status updates cannot clear
+// either the intent or the receipt.
+type TaskActorIdentityStore interface {
+	GetTaskActorIdentity(context.Context, string, string) (*ActorIdentity, error)
+	ClaimTaskActorCreation(context.Context, string, string, string) (bool, error)
+	RecordTaskActorIdentity(context.Context, string, string, ActorIdentity) error
+}
