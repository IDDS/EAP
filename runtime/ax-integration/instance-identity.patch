+func publicIdentityEnv(t *testing.T) map[string]string {
+	t.Helper()
+	public, _, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, _ := x509.MarshalPKIXPublicKey(public)
+	return map[string]string{"EAP_IDENTITY_MODE": IdentityMode, "EAP_IDENTITY_DIR": IdentityDirectory, "EAP_IDENTITY_PUBLIC_KEY": base64.StdEncoding.EncodeToString(der), "EAP_AX_TASK_KEY": "task", "EAP_AGENT_ID": "50", "EAP_GATEWAY_URL": "http://backend.eap.svc:8080"}
+}
+func TestIdentityTemplateProjectionAndPublicConfig(t *testing.T) {
+	env := publicIdentityEnv(t)
+	image := "registry/eap-task@sha256:" + strings.Repeat("a", 64)
+	if err := ValidateIdentityConfig("task", image, env); err != nil {
+		t.Fatal(err)
+	}
+	template := BuildActorTemplate("eap-ax", "t", image, env, nil, "gs://test")
+	if len(template.Volumes) != 2 || template.Volumes[1].Name != "eap-identity" || template.Volumes[1].SystemInfo == nil {
+		t.Fatal("missing native identity projection")
+	}
+	items := template.Volumes[1].GetSystemInfo().GetDataSources()[0].GetActorMetadata().GetItems()
+	if len(items) != 3 || items[0].GetPath() != "atespace" || items[1].GetPath() != "name" || items[2].GetPath() != "uid" || items[2].GetField() != ateapipb.ActorMetadataField_ACTOR_METADATA_FIELD_UID {
+		t.Fatal("projection does not come from native actor metadata")
+	}
+	if template.Containers[0].VolumeMounts[1].MountPath != IdentityDirectory {
+		t.Fatal("identity mount mismatch")
+	}
+	if BuildActorTemplate("eap-ax", "old", image, map[string]string{}, nil, "gs://test").Volumes[0].SystemInfo != nil {
+		t.Fatal("legacy launch contract changed")
+	}
+	for _, key := range []string{"EAP_GATEWAY_TOKEN", "EAP_TASK_TOKEN", "EAP_OBSERVABILITY_TOKEN", "GEMINI_API_KEY", "SUBSTRATE_TOKEN_FILE"} {
+		t.Run(key, func(t *testing.T) {
+			env[key] = "synthetic-denied-value"
+			if ValidateIdentityConfig("task", image, env) == nil {
+				t.Fatal("bearer/control config accepted")
+			}
+			delete(env, key)
+		})
+	}
+	if ValidateIdentityConfig("other", image, env) == nil || ValidateIdentityConfig("task", "registry:latest", env) == nil {
+		t.Fatal("mutable image or foreign task identity accepted")
+	}
+	changed := proto.Clone(template).(*ateapipb.ActorTemplate)
+	changed.Volumes[1].SystemInfo = nil
+	if sameIdentityTemplate(changed, template) {
+		t.Fatal("existing template without projection accepted")
+	}
+}
