+	// A new store object simulates a controller restart; pending intent cannot be reclaimed.
+	restarted := NewStore(client, options)
+	if ok, err := restarted.ClaimTaskActorCreation(ctx, "eap-ax", "task", "other"); err != nil || ok {
+		t.Fatal("restart retried unknown creation")
+	}
+	value := store.ActorIdentity{Template: "eap-ax/template", UID: "56592f45-ed6b-4d34-8d20-909957c16946"}
+	if err := restarted.RecordTaskActorIdentity(ctx, "eap-ax", "task", value); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.RecordTaskActorIdentity(ctx, "eap-ax", "task", value); err != nil {
+		t.Fatal(err)
+	}
+	value.UID = "different"
+	if !errors.Is(s.RecordTaskActorIdentity(ctx, "eap-ax", "task", value), store.ErrActorIdentityConflict) {
+		t.Fatal("UID rebound")
+	}
+	if err := s.UpdateTaskStatus(ctx, "eap-ax", "task", &v1alpha1.TaskStatus{Phase: "Running"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.DeleteTask(ctx, "eap-ax", "task"); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.SaveTask(ctx, task); err != nil {
+		t.Fatal(err)
+	}
+	if ok, err := s.ClaimTaskActorCreation(ctx, "eap-ax", "task", "another"); err != nil || ok {
+		t.Fatal("task deletion removed create tombstone")
+	}
+	id, err := s.GetTaskActorIdentity(ctx, "eap-ax", "task")
+	if err != nil || id.UID == "different" || id.UID == "" {
+		t.Fatal("stored original UID lost", err)
+	}
