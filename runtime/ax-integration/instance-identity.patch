+type receiptClient struct {
+	ateapipb.ControlClient
+	actor         *ateapipb.Actor
+	err           error
+	creates, gets int
+}
+
+func (c *receiptClient) CreateActor(context.Context, *ateapipb.CreateActorRequest, ...grpc.CallOption) (*ateapipb.Actor, error) {
+	c.creates++
+	return c.actor, c.err
+}
+func (c *receiptClient) GetActor(context.Context, *ateapipb.GetActorRequest, ...grpc.CallOption) (*ateapipb.Actor, error) {
+	c.gets++
+	return c.actor, c.err
+}
+func goodActor() *ateapipb.Actor {
+	return &ateapipb.Actor{Metadata: &ateapipb.ResourceMetadata{Atespace: "eap-ax", Name: "task", Uid: testUID}, ActorTemplate: &ateapipb.ObjectRef{Atespace: "eap-ax", Name: "template"}, Status: &ateapipb.ActorStatus{State: ateapipb.ActorState_ACTOR_STATE_SUSPENDED}}
+}
+func TestOwnedActorNeverAdoptsOrRecreates(t *testing.T) {
+	for _, code := range []codes.Code{codes.AlreadyExists, codes.DeadlineExceeded, codes.Unavailable} {
+		t.Run(code.String(), func(t *testing.T) {
+			api := &receiptClient{actor: goodActor(), err: status.Error(code, "synthetic uncertainty")}
+			c := &Client{control: api}
+			if _, err := c.CreateOwnedActor(context.Background(), "eap-ax", "task", "eap-ax", "template"); err == nil {
+				t.Fatal("uncertain create accepted")
+			}
+			if api.creates != 1 || api.gets != 0 {
+				t.Fatal("create failure triggered name adoption/retry")
+			}
+		})
+	}
+	api := &receiptClient{actor: goodActor()}
+	c := &Client{control: api}
+	if _, err := c.CreateOwnedActor(context.Background(), "eap-ax", "task", "eap-ax", "template"); err != nil {
+		t.Fatal(err)
+	}
+	api.actor.Metadata.Uid = "77c266aa-e65e-4c66-ac08-02fcf07499c2"
+	if _, err := c.GetOwnedActor(context.Background(), "eap-ax", "task", "eap-ax", "template", testUID); err == nil {
+		t.Fatal("replacement UID accepted")
+	}
+	api.err = status.Error(codes.NotFound, "missing")
+	if _, err := c.GetOwnedActor(context.Background(), "eap-ax", "task", "eap-ax", "template", testUID); err == nil {
+		t.Fatal("missing actor accepted")
+	}
+	if api.creates != 1 {
+		t.Fatal("bound identity check recreated actor")
+	}
+}
+func TestOwnedActorReceiptValidation(t *testing.T) {
+	cases := map[string]func(*ateapipb.Actor){"missing UID": func(a *ateapipb.Actor) { a.Metadata.Uid = "" }, "foreign name": func(a *ateapipb.Actor) { a.Metadata.Name = "foreign" }, "foreign space": func(a *ateapipb.Actor) { a.Metadata.Atespace = "foreign" }, "foreign template": func(a *ateapipb.Actor) { a.ActorTemplate.Name = "foreign" }, "crashed": func(a *ateapipb.Actor) { a.Status.State = ateapipb.ActorState_ACTOR_STATE_CRASHED }, "deleting": func(a *ateapipb.Actor) { a.Status.State = ateapipb.ActorState_ACTOR_STATE_DELETING }}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
+			a := goodActor()
+			change(a)
+			if ValidateActorIdentity(a, "eap-ax", "task", "eap-ax", "template", testUID) == nil {
+				t.Fatal("invalid native receipt accepted")
+			}
+		})
+	}
