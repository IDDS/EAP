+	var count atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			ok, err := s.ClaimTaskActorCreation(ctx, "eap-ax", "task", "eap-ax/template")
+			if err != nil {
+				t.Error(err)
+			}
+			if ok {
+				count.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	if count.Load() != 1 {
+		t.Fatalf("durable claim winners=%d", count.Load())
+	}
+	if ttl := client.TTL(ctx, s.actorIdentityKey("eap-ax", "task")).Val(); ttl != -1 {
+		t.Fatalf("create intent expires: %v", ttl)
