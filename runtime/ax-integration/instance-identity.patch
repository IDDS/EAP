+package substrate
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/x509"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/protobuf/proto"
+)
+
+const IdentityMode = "PER_INSTANCE_V1"
+const IdentityDirectory = "/run/eap-identity"
+
+func IsIdentityTask(env map[string]string) bool { return env["EAP_IDENTITY_MODE"] == IdentityMode }
+
+// New EAP tasks have a closed public configuration contract. There is no
+// compatibility fallback that can introduce shared/provider/control credentials.
+func ValidateIdentityConfig(name, image string, env map[string]string) error {
+	if env["EAP_IDENTITY_MODE"] == "" {
+		return nil
+	}
+	if !IsIdentityTask(env) {
+		return errors.New("unsupported EAP identity mode")
+	}
+	allowed := map[string]bool{"EAP_IDENTITY_MODE": true, "EAP_IDENTITY_PUBLIC_KEY": true, "EAP_IDENTITY_DIR": true, "EAP_AGENT_ID": true, "EAP_AX_TASK_KEY": true, "EAP_GATEWAY_URL": true}
+	for key := range env {
+		if !allowed[key] {
+			return errors.New("instance task accepts public identity configuration only")
+		}
+	}
+	if env["EAP_AX_TASK_KEY"] != name || env["EAP_IDENTITY_DIR"] != IdentityDirectory || env["EAP_GATEWAY_URL"] == "" {
+		return errors.New("incomplete task identity configuration")
+	}
+	n, err := strconv.ParseInt(env["EAP_AGENT_ID"], 10, 64)
+	if err != nil || n < 1 || strconv.FormatInt(n, 10) != env["EAP_AGENT_ID"] {
+		return errors.New("invalid task agent identity")
+	}
+	if !regexp.MustCompile(`^[^\s@]+@sha256:[a-f0-9]{64}$`).MatchString(image) {
+		return errors.New("task runner image must be pinned")
+	}
+	raw, err := base64.StdEncoding.DecodeString(env["EAP_IDENTITY_PUBLIC_KEY"])
+	if err != nil {
+		return errors.New("invalid identity trust")
+	}
+	public, err := x509.ParsePKIXPublicKey(raw)
+	if err != nil {
+		return errors.New("invalid identity trust")
+	}
+	if _, ok := public.(ed25519.PublicKey); !ok {
+		return errors.New("Ed25519 identity trust required")
+	}
+	return nil
+}
+
+func projectActorIdentity(template *ateapipb.ActorTemplate) {
+	template.Containers[0].VolumeMounts = append(template.Containers[0].VolumeMounts, &ateapipb.VolumeMount{Name: "eap-identity", MountPath: IdentityDirectory})
+	template.Volumes = append(template.Volumes, &ateapipb.Volume{Name: "eap-identity", SystemInfo: &ateapipb.SystemInfoVolumeSource{DataSources: []*ateapipb.SystemInfoDataSource{{ActorMetadata: &ateapipb.ActorMetadataDataSource{Items: []*ateapipb.ActorMetadataItem{
+		{Field: ateapipb.ActorMetadataField_ACTOR_METADATA_FIELD_ATESPACE, Path: "atespace"},
+		{Field: ateapipb.ActorMetadataField_ACTOR_METADATA_FIELD_NAME, Path: "name"},
+		{Field: ateapipb.ActorMetadataField_ACTOR_METADATA_FIELD_UID, Path: "uid"},
+	}}}}}})
+}
+
+func sameIdentityTemplate(actual, expected *ateapipb.ActorTemplate) bool {
+	if actual == nil {
+		return false
+	}
+	// Native metadata and golden-snapshot status are server assigned. Launch
+	// configuration, projection and placement must all match the frozen request.
+	a, e := proto.Clone(actual).(*ateapipb.ActorTemplate), proto.Clone(expected).(*ateapipb.ActorTemplate)
+	sortEnv := func(t *ateapipb.ActorTemplate) {
+		for _, c := range t.Containers {
+			sort.Slice(c.Env, func(i, j int) bool { return c.Env[i].Name < c.Env[j].Name })
+		}
+	}
+	sortEnv(a)
+	sortEnv(e)
+	return proto.Equal(a.WorkerSelector, e.WorkerSelector) && proto.Equal(a.SnapshotsConfig, e.SnapshotsConfig) && proto.Equal(a.SandboxConfig, e.SandboxConfig) &&
+		proto.Equal(&ateapipb.ActorTemplate{Containers: a.Containers, Volumes: a.Volumes}, &ateapipb.ActorTemplate{Containers: e.Containers, Volumes: e.Volumes})
+}
+
+func ValidateActorIdentity(actor *ateapipb.Actor, space, name, templateSpace, templateName, uid string) error {
+	if actor == nil || actor.GetMetadata().GetAtespace() != space || actor.GetMetadata().GetName() != name ||
+		actor.GetActorTemplate().GetAtespace() != templateSpace || actor.GetActorTemplate().GetName() != templateName ||
+		!regexp.MustCompile(`^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$`).MatchString(actor.GetMetadata().GetUid()) ||
+		uid != "" && actor.GetMetadata().GetUid() != uid {
+		return errors.New("native actor receipt does not match frozen identity")
+	}
+	if state := actor.GetStatus().GetState(); state == ateapipb.ActorState_ACTOR_STATE_CRASHED || state == ateapipb.ActorState_ACTOR_STATE_DELETING {
+		return errors.New("task actor is crashed or deleting; automatic recreation disabled")
+	}
+	return nil
+}
+
+// CreateOwnedActor accepts only the successful create response. ALREADY_EXISTS,
+// missing receipts and transport ambiguity never fall back to a name lookup.
+func (c *Client) CreateOwnedActor(ctx context.Context, space, name, templateSpace, templateName string) (*ateapipb.Actor, error) {
+	actor, err := c.control.CreateActor(ctx, &ateapipb.CreateActorRequest{Actor: &ateapipb.Actor{Metadata: &ateapipb.ResourceMetadata{Atespace: space, Name: name}, ActorTemplate: &ateapipb.ObjectRef{Atespace: templateSpace, Name: templateName}}})
+	if err != nil {
+		return nil, fmt.Errorf("native actor create result not bound: %w", err)
+	}
+	if err = ValidateActorIdentity(actor, space, name, templateSpace, templateName, ""); err != nil {
+		return nil, err
+	}
+	return actor, nil
+}
+
+// GetOwnedActor never creates anything when a bound actor disappears or changes.
+func (c *Client) GetOwnedActor(ctx context.Context, space, name, templateSpace, templateName, uid string) (*ateapipb.Actor, error) {
+	if uid == "" {
+		return nil, errors.New("native create receipt required")
+	}
+	actor, err := c.control.GetActor(ctx, &ateapipb.GetActorRequest{Actor: &ateapipb.ObjectRef{Atespace: space, Name: name}})
+	if err != nil {
+		return nil, err
+	}
+	if err = ValidateActorIdentity(actor, space, name, templateSpace, templateName, uid); err != nil {
+		return nil, err
+	}
+	return actor, nil
+}
