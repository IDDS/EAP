+func TestRealRedisActorClaimReceiptAndRestart(t *testing.T) {
+	address := os.Getenv("EAP_TEST_REDIS_ADDR")
+	if address == "" {
+		t.Fatal("independent Redis test server required")
+	}
+	ctx := context.Background()
+	client := redis.NewClient(&redis.Options{Addr: address})
+	defer client.Close()
+	if err := client.Ping(ctx).Err(); err != nil {
+		t.Fatal(err)
+	}
+	options := Options{KeyPrefix: "eap-identity-test-" + time.Now().Format("150405.000000000"), StreamName: "eap-identity-test-events", TTL: time.Hour}
+	s := NewStore(client, options)
+	task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Atespace: "eap-ax", Name: "task"}}
+	if err := s.SaveTask(ctx, task); err != nil {
