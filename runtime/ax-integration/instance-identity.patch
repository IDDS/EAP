+package redis
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+
+	"github.com/google/ax/internal/store"
+	"github.com/redis/go-redis/v9"
+)
+
+func (s *Store) actorIdentityKey(space, name string) string {
+	if space == "" {
+		space = "default"
+	}
+	return fmt.Sprintf("%s:eap-actor-identity:%s:%s", s.opts.KeyPrefix, space, name)
+}
+
+func (s *Store) GetTaskActorIdentity(ctx context.Context, space, name string) (*store.ActorIdentity, error) {
+	raw, err := s.client.Get(ctx, s.actorIdentityKey(space, name)).Bytes()
+	if err == redis.Nil {
+		return nil, store.ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	var value store.ActorIdentity
+	if json.Unmarshal(raw, &value) != nil || value.Template == "" {
+		return nil, store.ErrActorIdentityConflict
+	}
+	return &value, nil
+}
+
+// The task's existence/cancellation and SET NX share a single Redis operation.
+// No expiry is used, even when ordinary task records have a configured TTL.
+const claimActorScript = `
+local task = redis.call('GET', KEYS[1])
+if not task then return -1 end
+local t = cjson.decode(task)
+if t.status and t.status.phase == 'Terminating' then return -2 end
+if redis.call('EXISTS', KEYS[2]) == 1 then return 0 end
+redis.call('SET', KEYS[2], ARGV[1])
+return 1`
+
+func (s *Store) ClaimTaskActorCreation(ctx context.Context, space, name, template string) (bool, error) {
+	if template == "" {
+		return false, store.ErrActorIdentityConflict
+	}
+	raw, _ := json.Marshal(store.ActorIdentity{Template: template})
+	value, err := s.client.Eval(ctx, claimActorScript, []string{s.taskKey(space, name), s.actorIdentityKey(space, name)}, string(raw)).Int()
+	if err != nil {
+		return false, err
+	}
+	if value == -1 {
+		return false, store.ErrNotFound
+	}
+	if value == -2 {
+		return false, store.ErrActorIdentityConflict
+	}
+	return value == 1, nil
+}
+
+const recordActorScript = `
+local raw = redis.call('GET', KEYS[1])
+if not raw then return 0 end
+local previous = cjson.decode(raw)
+local value = cjson.decode(ARGV[1])
+if previous.actorTemplate ~= value.actorTemplate then return 0 end
+if previous.actorUid and previous.actorUid ~= '' and previous.actorUid ~= value.actorUid then return 0 end
+redis.call('SET', KEYS[1], ARGV[1])
+return 1`
+
+func (s *Store) RecordTaskActorIdentity(ctx context.Context, space, name string, value store.ActorIdentity) error {
+	if value.UID == "" || value.Template == "" {
+		return store.ErrActorIdentityConflict
+	}
+	raw, _ := json.Marshal(value)
+	result, err := s.client.Eval(ctx, recordActorScript, []string{s.actorIdentityKey(space, name)}, string(raw)).Int()
+	if err != nil {
+		return err
+	}
+	if result != 1 {
+		return store.ErrActorIdentityConflict
+	}
+	return nil
+}
